VITE_SUPABASE_URL=https://mrfblzsihpecockhsnqe.supabase.co
VITE_VIATOR_FN_URL=https://mrfblzsihpecockhsnqe.supabase.co/functions/v1/viator-cards
VITE_SUPABASE_ANON_KEY=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Natural-language itinerary editing. OFF unless VITE_NL_EDIT is exactly 'true'.
# Do not enable in production until the Privacy Policy documents the processing
# and sub-processor — the free-text box invites personal data by design.
VITE_NL_EDIT=false
VITE_ITINERARY_EDIT_FN_URL=https://mrfblzsihpecockhsnqe.supabase.co/functions/v1/itinerary-edit

# Semantic search in Explore. OFF unless VITE_SEMANTIC_SEARCH is exactly 'true'.
# Sends the traveller's typed query to an embedding provider — same Privacy
# Policy gate as VITE_NL_EDIT. Do not enable until the migration is applied and
# the golden set has been run.
VITE_SEMANTIC_SEARCH=false
VITE_SEARCH_FN_URL=https://mrfblzsihpecockhsnqe.supabase.co/functions/v1/search
