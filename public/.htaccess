# SPA fallback: send unknown paths to index.html so client-side routing works
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# FIRST-PARTY PATH TO THE EDGE FUNCTIONS.
#
# Requests to *.supabase.co are on the common ad-blocker filter lists, and a
# blocker that black-holes rather than refuses turns them into multi-minute
# hangs — which is how the stats page came to sit on "Loading" and the login box
# on "Sending…" for two minutes, while the same calls answered in under a second
# from elsewhere. Routing them through this domain removes the third-party
# hostname entirely: same origin as the page, nothing for a filter list to match.
#
# It also closes the analytics undercount the design flagged as an open risk —
# beacons that blockers were dropping now go to 10daysonaruba.com.
#
# If mod_proxy is not available on this host these paths return 500 and nothing
# else is affected; the app falls back to the direct URL.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/fn/([a-z-]+)$ https://mrfblzsihpecockhsnqe.supabase.co/functions/v1/$1 [P,L]
</IfModule>

# Force HTTPS once Let's Encrypt is enabled in TransIP CP
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^localhost
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Cache hashed build assets for a year (filenames change on every build).
#
# THIS WAS SILENTLY DOING NOTHING. The rules below used to live only in an
# <IfModule mod_expires.c> block, and mod_expires is not loaded on this host —
# an IfModule guard that does not match is skipped without a word. Measured on
# 2026-08-23: the main bundle came back with NO cache-control header at all, so
# every visitor re-downloaded 418 KB gzipped (3.1 MB of assets in total) on
# every page load. mod_headers IS loaded — the index.html rule below has been
# working — so the same job is done with Header, and mod_expires is kept only as
# a bonus if the host ever gains it.
#
# Safe because Vite fingerprints every filename: index-CZLjywM4.js changes on
# each build, so a year-long cache can never serve a stale bundle. index.html
# itself is excluded and stays no-cache, which is what makes a deploy visible.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Never cache index.html so deploys are reflected immediately
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>

# Gzip text responses
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
